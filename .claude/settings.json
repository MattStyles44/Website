{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/format.mjs"],
            "timeout": 60,
            "statusMessage": "Formatteren en linten..."
          }
        ]
      }
    ]
  }
}
