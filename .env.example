# Copy to .env.local and adjust. All variables are optional and have defaults.
# Validated at startup by src/env.ts.

# One of: development, test, production (set automatically by Next.js)
NODE_ENV=development

# Display name used in the UI
APP_NAME=SignUp Reclame

# Public base URL of the app
APP_URL=http://localhost:3000
# Productie: https://www.sign-up.nl (gebruikt voor canonical URLs, sitemap en robots)

# Sanity (CMS). Zonder project-ID toont de site de vaste teksten uit de code.
# Project-ID en dataset zijn openbaar; zie studio/sanity.cli.ts.
SANITY_PROJECT_ID=
SANITY_DATASET=production

# Geheim (min. 16 tekens) voor de webhook van Sanity naar /api/revalidate.
# Zelf kiezen, en hetzelfde geheim invullen bij de webhook op sanity.io/manage.
SANITY_WEBHOOK_SECRET=

# Mail via Resend (resend.com). Met beide waarden ingevuld verstuurt de site
# echte mail; zonder schrijft ze per mail alleen een regel naar het log.
# API-sleutel uit het Resend-dashboard (begint met re_). Geheim: nooit committen.
RESEND_API_KEY=
# Afzender op een domein dat in Resend geverifieerd is (SPF en DKIM, zie
# docs/processen.md): adres@domein.nl of Naam <adres@domein.nl>.
MAIL_FROM=
